Project foodverse {
  database_type: 'MySQL'
  Note: 'ERD relasional dari model Mongoose project FoodVerse. Di kode saat ini table dan paymentMethod pada Order masih string; untuk MySQL dinormalisasi menjadi foreign key.'
}

Table users {
  id bigint [pk, increment]
  name varchar(100) [not null]
  email varchar(150) [not null, unique]
  password varchar(255) [not null]
  is_admin boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp
}

Table products {
  id bigint [pk, increment]
  name varchar(150) [not null]
  image text [not null]
  description text [not null]
  category varchar(100) [not null]
  price decimal(12,2) [not null]
  rating decimal(3,2) [not null, default: 0]
  created_at timestamp
  updated_at timestamp
}

Table tables {
  id bigint [pk, increment]
  name varchar(100) [not null]
  created_at timestamp
  updated_at timestamp
}

Table payment_methods {
  id bigint [pk, increment]
  name varchar(100) [not null]
  created_at timestamp
  updated_at timestamp
}

Table orders {
  id bigint [pk, increment]
  user_id bigint [not null]
  table_id bigint [not null]
  payment_method_id bigint [not null]
  order_name varchar(150) [not null]
  total_price decimal(12,2) [not null, default: 0]
  status varchar(50) [not null, default: 'Diproses']
  created_at timestamp
  updated_at timestamp
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [not null]
  name varchar(150) [not null, note: 'Snapshot nama produk saat order dibuat']
  qty int [not null]
  image text [not null, note: 'Snapshot gambar produk saat order dibuat']
  price decimal(12,2) [not null, note: 'Snapshot harga produk saat order dibuat']
}

Ref: orders.user_id > users.id
Ref: orders.table_id > tables.id
Ref: orders.payment_method_id > payment_methods.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
